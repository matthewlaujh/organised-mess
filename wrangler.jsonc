{
	// Cloudflare Workers — static site in ./site with a tiny Worker (worker.js)
	// that serves the Capabilities deep link. _headers in site/ are honoured.
	"name": "organised-mess-web",
	"main": "worker.js",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./site",
		"binding": "ASSETS",
		"not_found_handling": "404-page"
	}
}
